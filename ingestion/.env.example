# Set these in Render's environment fields; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=YOUR_EXISTING_R2_BUCKET
AWS_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_READ_ONLY_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_BUCKET_SCOPED_READ_ONLY_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
# API service only. Render generates its real value automatically.
API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
POLL_SECONDS=30
RECONCILE_SECONDS=3600
INITIAL_LOOKBACK_SECONDS=3600
MEASUREMENT_RETENTION_DAYS=1
# Optional worker registry JSON. Without it, R2_BUCKET seeds Tabor Boy's existing prefix.
# NODE_REGISTRY_PATH=/etc/secrets/nodes.json
